#!/usr/bin/env python3
"""Unit checks for PathEngine traffic-aware routing."""

import networkx as nx

from path_engine import PathEngine


def main():
    graph = nx.Graph()
    graph.add_edges_from([
        (1, 2), (2, 4),
        (1, 3), (3, 4),
    ])

    engine = PathEngine(graph)
    baseline = engine.find_path(1, 4)
    assert baseline in ([1, 2, 4], [1, 3, 4])

    engine.update_link_metric(1, 2, utilization=0.99)
    traffic_aware = engine.find_path(1, 4)
    assert traffic_aware == [1, 3, 4]

    operational = graph.copy()
    isolated = (1, 3)
    operational.remove_edge(*isolated)
    engine.set_graph(operational)
    assert engine.find_path(1, 4) == [1, 2, 4]

    operational.remove_edge(1, 2)
    engine.set_graph(operational)
    assert engine.find_path(1, 4) is None

    print("path_engine_test: PASS")


if __name__ == "__main__":
    main()
