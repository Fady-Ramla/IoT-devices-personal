{
  "version": "application-window-v2",
  "task": "detect repeated failed-login bursts; not classify arbitrary malicious payloads",
  "target": "label",
  "group_column": "run_id",
  "window_seconds": 5,
  "labels": [
    "Malicious_POST",
    "Normal"
  ],
  "features": [
    "total_requests",
    "post_count",
    "auth_post_count",
    "auth_post_2xx_count",
    "auth_post_401_count",
    "auth_post_4xx_other_count",
    "auth_post_5xx_count",
    "auth_get_count",
    "health_get_count",
    "iot_api_post_count",
    "other_route_post_count",
    "all_2xx_count",
    "all_4xx_count",
    "all_5xx_count",
    "auth_post_rate_per_sec",
    "auth_401_rate_per_sec"
  ],
  "excluded_columns": [
    "run_id",
    "observation_id",
    "window_index",
    "label",
    "label_status",
    "src_ip",
    "src_port",
    "dst_ip",
    "dst_port",
    "timestamp",
    "generation",
    "application_observation_id",
    "request_body",
    "payload",
    "password",
    "authorization",
    "cookie",
    "headers",
    "url_path",
    "query_string"
  ],
  "privacy": "No request body, credentials, URL path, headers, or raw IPs are model inputs or dataset outputs.",
  "evaluation": "Split by run_id; report row/window metrics and mean-probability run-level metrics.",
  "policy": "Shadow evaluation only. No blocking, BLOCK_DEVICE, quarantine, or automated response is enabled."
}
